{
  "name": "eagle-span",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun run redirects:build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check --minimumSeverity error",
    "lint": "eslint . --max-warnings 0",
    "lint:typography": "node scripts/lint-typography.mjs",
    "test": "bun test",
    "fonts:build": "python3 scripts/build-fonts.py",
    "fonts:build:og": "python3 scripts/build-fonts.py --og-only",
    "verify:fonts": "node scripts/verify-fonts.mjs",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "redirects:build": "node scripts/build-vercel-json.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:static-build": "node scripts/verify-static-build.mjs",
    "verify:redirects": "node scripts/verify-redirects.mjs",
    "verify:jsonld": "node scripts/verify-jsonld.mjs",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "check": "bun run typecheck && bun run lint && bun run lint:typography && bun run test && bun run verify:fonts && bun run verify:tokens && bun run verify:content && bun run build && bun run verify:static-build && bun run verify:jsonld && bun run verify:sitemap"
  },
  "dependencies": {
    "@astrojs/markdoc": "^0.15.11",
    "@astrojs/vercel": "^8.2.9",
    "@markdoc/markdoc": "^0.5.9",
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^4.3.1",
    "@eslint/js": "^9.37.0",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.9",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.37.0",
    "eslint-plugin-astro": "^1.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "satori": "^0.33.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  }
}
