---
import { render } from 'astro:content';

import BaseLayout from '~/layouts/BaseLayout.astro';
import CtaBand from '~/components/CtaBand.astro';
import Figure from '~/components/Figure.astro';
import PageHeader from '~/components/PageHeader.astro';
import Quotes from '~/components/Quotes.astro';
import { getSingleton, listTestimonials } from '~/lib/content.ts';
import { PAGES, pageCrumbs } from '~/lib/routes.ts';

import shopBays from '~/assets/photos/shop-bays.webp';
import techAtWheel from '~/assets/photos/tech-at-front-wheel.webp';

/*
 * `/company/about`. `data/redirects.csv` also sends the bare `/company` here,
 * which the live site 404s.
 */
const page = await getSingleton('about');
const { Content } = await render(page);

const path = PAGES.about;
const crumbs = pageCrumbs('About', path);

/* The shop, its people and its equipment. */
const shots = [
  { image: shopBays, alt: 'The Eagle Span service bays in Charlotte, with heavy-duty trucks on the racks' },
  { image: techAtWheel, alt: 'A technician at the front wheel of a truck inside the Charlotte shop' },
];

const testimonials = await listTestimonials();
---

<BaseLayout
  title={page.data.seo.title}
  description={page.data.seo.description}
  {path}
  {crumbs}
  pageType="AboutPage"
  noindex={page.data.seo.noindex}
  canonical={page.data.seo.canonical}
  image={page.data.seo.image?.src}
>
  <PageHeader
    mark="About"
    title={page.data.title}
    lede={page.data.lede}
    {crumbs}
    image={page.data.hero}
    imageAlt={page.data.heroAlt}
  />

  <div class="l-band">
    <div class="l-page">
      <div class="l-rail">
        <p class="l-rail__mark u-label">Shop</p>
        <div class="l-rail__body">
          <div class="l-split">
            <Content />

            <div class="about__shots">
              {
                shots.map((shot) => (
                  <Figure
                    image={shot.image}
                    alt={shot.alt}
                    ratio="4 / 3"
                    sizes="(width >= 64rem) 20rem, 92vw"
                    class="u-reveal-item"
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <Quotes items={testimonials} />

  <CtaBand
    id="about-cta"
    kicker="Next"
    heading="Bring a truck to the shop"
    lede="Call and talk to someone who works on these trucks, or send the details and we will come back to you with a time."
  />
</BaseLayout>

<style>
  .about__shots { display: grid; gap: var(--s-3); }
</style>
