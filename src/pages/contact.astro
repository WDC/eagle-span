---
import { render } from 'astro:content';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Form from '~/components/forms/Form.astro';
import LocationCard from '~/components/LocationCard.astro';
import PageHeader from '~/components/PageHeader.astro';
import { getSingleton } from '~/lib/content.ts';
import { PAGES, pageCrumbs } from '~/lib/routes.ts';
import { site } from '~/site.config.ts';

/*
 * `/contact`.
 *
 * No Google Maps iframe. The live page embeds one — roughly 900 KB of
 * third-party JavaScript, a set of cookies this site otherwise never sets, and
 * therefore a consent question — for a picture of a street corner.
 * `LocationCard.astro` gives the reader the two things that iframe was for,
 * where the shop is and how to get directions, from this origin.
 *
 * The form posts to `/api/contact`, the one serverless function the deployed
 * site carries. `formIntro` and `formSuccess` are in the content model, so the
 * copy above the form and the copy after it are written by an editor rather
 * than living inside the function.
 */
const page = await getSingleton('contact');
const { Content } = await render(page);

const path = PAGES.contact;
const crumbs = pageCrumbs('Contact', path);
---

<BaseLayout
  title={page.data.seo.title}
  description={page.data.seo.description}
  {path}
  {crumbs}
  pageType="ContactPage"
  noindex={page.data.seo.noindex}
  canonical={page.data.seo.canonical}
  image={page.data.seo.image?.src}
>
  <PageHeader
    mark="Contact"
    title={page.data.title}
    lede={page.data.lede}
    {crumbs}
    image={page.data.hero}
    imageAlt={page.data.heroAlt}
  />

  <div class="l-band">
    <div class="l-page l-split">
      <div class="contact__body">
        <Content />

        {/*
          The two channels that are not the form. They stay above it rather
          than under it: a reader whose truck is down should reach the number
          before they reach the first input.
        */}
        <div class="c-panel c-panel--raised contact__reach">
          <p class="c-kicker">
            <span class="c-tick" aria-hidden="true" />
            <span class="u-label">Reach the shop</span>
          </p>
          <p class="contact__intro">
            Fastest for a unit that is down. The form below is for everything else.
          </p>

          <div class="contact__actions">
            <a
              class="c-btn c-btn--primary u-tabular u-nowrap"
              href={`tel:${site.phoneE164}`}
              data-conversion="call"
            >
              {site.phoneDisplay}
            </a>
            <a class="c-btn c-btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
              Directions<span class="u-visually-hidden"> (opens in a new tab)</span>
            </a>
          </div>
        </div>

        <Form
          kind="service"
          heading="Request service or a quote"
          intro={page.data.formIntro}
          success={page.data.formSuccess}
        />
      </div>

      <div class="contact__where">
        <h2 class="u-label contact__where-head">Where</h2>
        <LocationCard />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact__reach { margin-block-start: var(--s-6); }

  .contact__intro {
    color: var(--c-ink-2);
    margin-block-start: var(--s-1);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }

  .contact__where-head { margin-block-end: var(--s-3); }
</style>
