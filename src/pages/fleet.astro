---
import { render } from 'astro:content';

import BaseLayout from '~/layouts/BaseLayout.astro';
import CtaBand from '~/components/CtaBand.astro';
import Faqs from '~/components/Faqs.astro';
import Figure from '~/components/Figure.astro';
import PageHeader from '~/components/PageHeader.astro';
import { getEntries } from 'astro:content';
import Quotes from '~/components/Quotes.astro';
import { getSingleton, listTestimonials, resolveFaqs } from '~/lib/content.ts';

import shopBays from '~/assets/photos/shop-bays.webp';
import { PAGES, pageCrumbs } from '~/lib/routes.ts';
import { site } from '~/site.config.ts';
import { faqPageNode } from '~/lib/schema.ts';

/*
 * `/fleet` — the one new URL in the whole migration, and a stub by design.
 *
 * It is not a second `/services/fleet-services`. That page sells the work; this
 * one is the programme around it — which billing networks the shop honours,
 * how scheduling works for a yard of trucks. The two will read as duplicates
 * until Phase 3 gives this one its own copy, and until they don't, the honest
 * signal is `accounts: []`: which networks a shop bills through is a fact about
 * the business, not a fixture to invent.
 */
const page = await getSingleton('fleet');
const { Content } = await render(page);

const path = PAGES.fleet;
const crumbs = pageCrumbs('Fleet', path);

const accounts = page.data.accounts.length ? await getEntries(page.data.accounts) : [];
const faqs = await resolveFaqs(page.data.faqs);
const testimonials = await listTestimonials();

const schema = faqs.length ? [faqPageNode(path, faqs)] : [];
---

<BaseLayout
  title={page.data.seo.title}
  description={page.data.seo.description}
  {path}
  {crumbs}
  {schema}
  noindex={page.data.seo.noindex}
  canonical={page.data.seo.canonical}
  image={page.data.seo.image?.src}
>
  <PageHeader
    mark="Fleet"
    title={page.data.title}
    lede={page.data.lede}
    {crumbs}
    image={page.data.hero}
    imageAlt={page.data.heroAlt}
  />

  <div class="l-band">
    <div class="l-page">
      <div class="l-rail">
        <p class="l-rail__mark u-label">Programme</p>
        <div class="l-rail__body">
          <div class="l-split">
            <Content />

            <aside class="c-panel c-panel--raised l-sticky" aria-label="Fleet enquiries">
              <p class="c-kicker">
                <span class="c-tick" aria-hidden="true" />
                <span class="u-label">Fleet desk</span>
              </p>
              <p class="fleet__aside-note">
                Scheduling a yard of trucks, or setting up billing? Call the shop and ask for the
                fleet side.
              </p>
              <div class="fleet__aside-actions">
                <a class="c-btn c-btn--primary c-btn--block u-tabular u-nowrap" href={`tel:${site.phoneE164}`} data-conversion="call">
                  {site.phoneDisplay}
                </a>
                <a class="c-btn c-btn--ghost c-btn--block" href={PAGES.contact}>
                  Schedule service<span class="c-btn__mark" aria-hidden="true">→</span>
                </a>
              </div>
            </aside>
          </div>

          <Figure
            class="fleet__shot"
            image={shopBays}
            alt="The Eagle Span service bays in Charlotte, with heavy-duty trucks on the racks"
            ratio="21 / 9"
            sizes="(width >= 64rem) 60rem, 92vw"
          />
        </div>
      </div>
    </div>
  </div>

  {
    accounts.length > 0 && (
      <section class="l-band l-band--ground-2" aria-labelledby="accounts-heading">
        <div class="l-page">
          <div class="l-rail">
            <p class="l-rail__mark u-label">Billing</p>
            <div class="l-rail__body">
              <h2 id="accounts-heading">National accounts</h2>
              <ul class="l-grid accounts" style="--min: 14rem;">
                {accounts.map((account) => (
                  <li class="c-panel accounts__row u-reveal-item">
                    <p class="accounts__name">
                      {account.data.url ? (
                        <a href={account.data.url} target="_blank" rel="noopener noreferrer">
                          {account.data.name}
                          <span class="u-visually-hidden"> (opens in a new tab)</span>
                        </a>
                      ) : (
                        account.data.name
                      )}
                    </p>
                    {account.data.note && <p class="accounts__note">{account.data.note}</p>}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <Faqs items={faqs} heading="Fleet questions" />
  <Quotes items={testimonials} id="quotes-fleet" />

  <CtaBand
    id="fleet-cta"
    kicker="Fleet"
    heading="Put your yard on a schedule"
    lede="Tell us how many units you run and what they do, and we will come back with a maintenance interval and a plan for the ones already down."
    secondaryLabel="Talk to us about a fleet"
  />
</BaseLayout>

<style>
  .fleet__aside-note {
    color: var(--c-ink-2);
    font-size: var(--t-fine);
    margin-block-start: var(--s-1);
  }

  .fleet__aside-actions {
    display: grid;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }

  .fleet__shot { margin-block-start: var(--s-6); }

  .accounts {
    list-style: none;
    padding: 0;
    margin-block-start: var(--s-4);
  }

  .accounts__row { padding: var(--s-3); }
  .accounts__name { font-weight: 620; }

  .accounts__note {
    color: var(--c-ink-3);
    font-size: var(--t-fine);
    margin-block-start: var(--s-1);
  }
</style>
