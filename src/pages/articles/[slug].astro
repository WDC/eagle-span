---
import { render } from 'astro:content';

import BaseLayout from '~/layouts/BaseLayout.astro';
import Figure from '~/components/Figure.astro';
import PageHeader from '~/components/PageHeader.astro';
import { listArticles } from '~/lib/content.ts';
import { placeholderAt } from '~/lib/placeholders.ts';
import { SECTIONS, crumbsFor, entryPath } from '~/lib/routes.ts';
import { articleNode } from '~/lib/schema.ts';
import { site } from '~/site.config.ts';

/*
 * `/articles/{slug}` — not `/company/articles/{slug}`. The Phase 0 crawl
 * corrected the task's assumption here: the index sits under `/company` but
 * the seven entries never did, and moving them to make the two agree would
 * spend ranking on tidiness.
 *
 * This is the one template that keeps an `<article>` element, and it owns it
 * rather than inheriting it: Markdoc used to wrap every rendered body in one,
 * which put an `<article>` inside this `<article>` and an `<article>` around
 * a service page's spec table. The wrapper moved here, where the template
 * knows what the content is.
 */
export async function getStaticPaths() {
  const entries = await listArticles();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;

const path = entryPath('articles', entry.id);
const { Content } = await render(entry);

const crumbs = crumbsFor('articles', data.title, path);

const heroAlt = data.heroAlt ?? `Placeholder — an illustration for “${data.title}”`;

/*
 * A date is a reading: lining tabular figures, and an ISO `datetime` so the
 * machine-readable value and the printed one come from the same Date rather
 * than from two formatters.
 */
const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const published = data.publishedAt;
const updated = data.updatedAt;

const schema = [
  articleNode({
    path,
    headline: data.title,
    description: data.summary,
    publishedAt: published,
    updatedAt: updated,
    author: data.author,
    image: data.hero ? `${site.url}${data.hero.src}` : undefined,
  }),
];
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  {path}
  {crumbs}
  {schema}
  pageType="ItemPage"
  ogType="article"
  noindex={data.seo.noindex}
  canonical={data.seo.canonical}
  image={data.seo.image?.src}
  imageAlt={data.seo.image ? data.title : undefined}
>
  {/*
    The reading progress bar. A scroll timeline drives it — no listener, no
    script — and it exists only where that timeline does: `display: none` is the
    resting state, so a browser without scroll-driven animations gets no bar
    rather than a full green one it can never move. Articles only; a service
    page is not long enough to need to be told how far down it you are.
  */}
  <div class="progress" aria-hidden="true"><span class="progress__bar"></span></div>

  <article>
    <PageHeader mark="Article" title={data.title} lede={data.summary} {crumbs} {path}>
      <p class="byline">
        <span class="byline__by">{data.author ?? site.name}</span>
        <time class="u-tabular" datetime={published.toISOString()}>{dateFormat.format(published)}</time>
        {
          updated && (
            <span class="byline__updated">
              Updated <time class="u-tabular" datetime={updated.toISOString()}>{dateFormat.format(updated)}</time>
            </span>
          )
        }
      </p>
    </PageHeader>

    <div class="l-band">
      <div class="l-page">
        <Figure
          class="article__hero"
          image={
            data.hero
              ? data.hero
              : placeholderAt(`article-${entry.id}`, 'wide', heroAlt)
          }
          alt={heroAlt}
          ratio="21 / 9"
          eager
        />

        <div class="l-rail article__body">
          <p class="l-rail__mark u-label u-tabular">{published.getUTCFullYear()}</p>
          <div class="l-rail__body">
            <Content />

            {
              data.topics.length > 0 && (
                <ul class="topics">
                  {data.topics.map((topic: string) => (
                    <li class="c-chip">{topic}</li>
                  ))}
                </ul>
              )
            }

            <p class="article__back">
              <a class="c-link" href={SECTIONS.articles.index!}>
                All {SECTIONS.articles.label.toLowerCase()}<span class="c-arrow" aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    font-size: var(--t-fine);
    color: var(--c-ink-3);
  }

  .byline__by { color: var(--c-ink-2); font-weight: 620; }

  .article__hero { margin-block-end: var(--s-6); }
  .article__body { border-block-start: 0; padding-block-start: 0; }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    padding: 0;
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-4);
    border-block-start: var(--hairline) solid var(--c-rule);
  }

  .article__back { margin-block-start: var(--s-5); }

  /* ---- Reading progress ------------------------------------------------ */

  .progress {
    display: none;
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 55;
    block-size: 3px;
    pointer-events: none;
  }

  .progress__bar {
    display: block;
    block-size: 100%;
    background: var(--c-target);
    transform-origin: 0 50%;
  }

  /*
   * Opt in twice: the reader has not asked for less motion, and the browser can
   * drive an animation from the scroll position. Without both, the element is
   * not rendered at all — a progress bar that cannot progress is a green line
   * across somebody's screen.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .progress { display: block; }

      .progress__bar {
        animation: article-progress linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes article-progress {
    from { transform: scaleX(0); }
  }
</style>
