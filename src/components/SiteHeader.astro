---
import { NAV, PAGES } from '~/lib/routes.ts';
import { site } from '~/site.config.ts';
import { getSingleton } from '~/lib/content.ts';

/*
 * The header, on every page, and now sticky.
 *
 * The navigation is the fix for Phase 0 defect 10. `/service` and `/repair` are
 * both in the sitemap and neither was linked from any of the thirty crawled
 * pages — every template linked the fourteen children directly and skipped
 * their parents, so the two index pages accumulated no internal link equity at
 * all. Linking the indexes rather than the children is deliberate: fourteen
 * links in a header is a menu nobody reads and a link graph with no shape.
 *
 * The phone number is in the header because it is the action most visitors
 * want, and it renders from site.config like every other instance of it.
 *
 * Three things changed in the polish pass:
 *
 *   * **It sticks.** A truck is down and the number has to be one thumb-reach
 *     away at any scroll depth, not at the top of a 4,000px page.
 *   * **The narrow layout is a disclosure, not a wrap.** Five links, a number
 *     and a button reflowed into four rows, which is how the phone screenshot
 *     ended up with a masthead taller than the hero. It is a `<details>`: the
 *     browser owns the open state, the keyboard behaviour and the semantics,
 *     and the site's script budget stays where it is.
 *   * **It lifts on scroll**, on a scroll timeline rather than a listener —
 *     the same construction as the section reveals, for the same reason.
 */
const settings = await getSingleton('settings');
const { cta, announcement } = settings.data;

const path = Astro.url.pathname;
/* A section is current when the page is the index or one of its children. */
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(`${href}/`));
---

{
  announcement.enabled && announcement.text && (
    <aside class="announce" aria-label="Announcement">
      <div class="l-page announce__inner">
        <span class="c-tick" aria-hidden="true" />
        {announcement.href ? <a href={announcement.href}>{announcement.text}</a> : <span>{announcement.text}</span>}
      </div>
    </aside>
  )
}

<header class="masthead">
  <div class="l-page masthead__inner">
    <a class="masthead__brand" href={PAGES.home}>
      <span class="masthead__name">{site.name}</span>
      <span class="masthead__place u-label">{site.address.locality}, {site.address.region}</span>
    </a>

    <nav class="masthead__nav" aria-label="Primary">
      <ul class="masthead__list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="masthead__action">
      <a class="masthead__phone u-tabular u-nowrap" href={`tel:${site.phoneE164}`} data-conversion="call">
        <svg class="masthead__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M5.2 2.5 6.6 5.3 5.3 6.6a8.4 8.4 0 0 0 4.1 4.1l1.3-1.3 2.8 1.4v2.1c0 .6-.5 1-1.1 1A11.6 11.6 0 0 1 1.4 2.6c0-.6.5-1.1 1-1.1h2.1z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
        </svg>
        {site.phoneDisplay}
      </a>
      <a class="c-btn c-btn--primary masthead__cta" href={cta.href}>{cta.label}</a>
    </div>

    {/*
      The narrow-viewport menu. `<details>` rather than a button and a class:
      the open state, the Enter/Space handling and the “this thing expands”
      semantics are the browser’s, and a navigation that needs JavaScript to
      open is a navigation that is broken on the slow connection it matters on.
    */}
    <details class="menu">
      <summary class="menu__toggle">
        <span class="u-visually-hidden">Menu</span>
        <span class="menu__bars" aria-hidden="true" />
      </summary>

      <div class="menu__panel">
        <nav aria-label="Primary, narrow">
          <ul class="menu__list">
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                    <span class="c-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="menu__actions">
          <a class="c-btn c-btn--primary c-btn--block" href={cta.href}>{cta.label}</a>
          <a class="c-btn c-btn--ghost c-btn--block u-tabular u-nowrap" href={`tel:${site.phoneE164}`} data-conversion="call">
            {site.phoneDisplay}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .announce {
    background: var(--c-deep);
    color: var(--c-on-deep);
    font-size: var(--t-fine);
    padding-block: var(--s-1);
  }

  .announce__inner {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .announce a { color: var(--c-on-deep); }

  /* ---- The bar --------------------------------------------------------- */

  .masthead {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    border-block-end: var(--hairline) solid var(--c-rule);
    /*
     * Opaque enough to read over, translucent enough that the page moving
     * under it is visible. The fallback is a solid ground, because a
     * translucent bar without the blur is an unreadable bar.
     */
    background: var(--c-ground);
  }

  @supports (backdrop-filter: blur(8px)) {
    .masthead {
      background: color-mix(in srgb, var(--c-ground) 88%, transparent);
      backdrop-filter: blur(10px) saturate(140%);
    }
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    min-block-size: var(--h-masthead);
    padding-block: var(--s-2);
  }

  .masthead__brand {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    margin-inline-end: auto;
    /* The brand is the one thing that must not wrap at any width. */
    white-space: nowrap;
  }

  .masthead__name {
    font-weight: 620;
    letter-spacing: var(--ls-heading);
    font-size: var(--t-body);
  }

  .masthead__place { color: var(--c-ink-3); }

  .masthead__list {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .masthead__list a {
    display: block;
    text-decoration: none;
    font-size: var(--t-fine);
    font-weight: 560;
    padding-block: var(--s-1);
    border-block-end: 2px solid transparent;
    transition: color var(--d-fast) var(--e-out), border-color var(--d-fast) var(--e-out);
  }

  .masthead__list a:hover { border-block-end-color: var(--c-rule-strong); }

  /*
   * The current section is marked with a rule under the label, not a colour
   * swap: the mark has to survive being read by someone who cannot see it, and
   * `aria-current` is what actually says "you are here". The rule is the
   * alignment-target green, which is the one thing on this site that means
   * "this is the one" — as a border, never as the text colour.
   */
  .masthead__list a[aria-current='page'] {
    border-block-end-color: var(--c-target);
  }

  .masthead__action {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .masthead__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    font-weight: 620;
    font-size: var(--t-fine);
    text-decoration: none;
    transition: color var(--d-fast) var(--e-out);
  }

  .masthead__phone:hover { color: var(--c-target-ink); }
  .masthead__icon { inline-size: 1em; block-size: 1em; }

  /* ---- The narrow menu ------------------------------------------------- */

  .menu { display: none; position: relative; }

  .menu__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: var(--hairline) solid var(--c-rule);
    border-radius: var(--r-2);
    cursor: pointer;
    list-style: none;
  }

  .menu__toggle::-webkit-details-marker { display: none; }
  .menu__toggle::marker { content: ''; }

  /*
   * Three bars that become a cross: the middle one is the element, the other
   * two are its pseudo-elements, and opening the disclosure rotates the pair
   * onto each other. One box, no icon font, no second SVG.
   */
  .menu__bars,
  .menu__bars::before,
  .menu__bars::after {
    display: block;
    inline-size: 1.1rem;
    block-size: 2px;
    background: var(--c-ink);
    transition: transform var(--d-base) var(--e-out), opacity var(--d-fast) var(--e-out);
  }

  .menu__bars { position: relative; }

  .menu__bars::before,
  .menu__bars::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .menu__bars::before { transform: translateY(-0.36rem); }
  .menu__bars::after { transform: translateY(0.36rem); }

  .menu[open] .menu__bars { background: transparent; }
  .menu[open] .menu__bars::before { transform: rotate(0.125turn); }
  .menu[open] .menu__bars::after { transform: rotate(-0.125turn); }

  .menu__panel {
    position: absolute;
    inset-inline: auto 0;
    inset-block-start: calc(100% + var(--s-2));
    inline-size: min(20rem, calc(100vw - var(--gutter) * 2));
    padding: var(--s-4);
    background: var(--c-ground);
    border: var(--hairline) solid var(--c-rule);
    border-radius: var(--r-3);
    box-shadow: var(--shadow-3);
    display: grid;
    gap: var(--s-4);
  }

  .menu__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }

  .menu__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: var(--s-2);
    border-block-end: var(--hairline) solid var(--c-rule);
    text-decoration: none;
    font-weight: 620;
  }

  .menu__list li:last-child a { border-block-end: 0; }

  .menu__list a[aria-current='page'] { color: var(--c-target-ink); }

  .menu__list .c-arrow { color: var(--c-ink-3); }

  .menu__actions { display: grid; gap: var(--s-2); }

  /* ---- Widths ---------------------------------------------------------- */

  /*
   * One breakpoint, and it is the width the five nav labels stop fitting
   * alongside the brand and the number. Below it the links move into the
   * disclosure and the number stays out — it is the reason most people are
   * on the page.
   */
  @media (width < 64rem) {
    .masthead__nav { display: none; }
    .menu { display: block; }
    .masthead__cta { display: none; }
  }

  @media (width < 30rem) {
    /* At this width the number alone is wider than the brand. Icon only. */
    .masthead__phone { font-size: 0; gap: 0; }
    .masthead__icon { inline-size: 1.15rem; block-size: 1.15rem; }
  }

  /* ---- Motion ---------------------------------------------------------- */

  /*
   * The bar earns its shadow by leaving the top of the page, on a scroll
   * timeline: no listener, no class toggled from script, nothing to run on a
   * thread that is busy. A browser without scroll-driven animations gets a bar
   * that always carries its hairline, which is the resting state and is
   * correct on its own.
   *
   * `both` fill is right here for the reason the gate allows it only with
   * `animation-timeline`: the fill holds the end state across the rest of the
   * scroll range rather than freezing a moment of a time-based animation.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .masthead {
        animation: masthead-lift linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 96px;
      }
    }
  }

  @keyframes masthead-lift {
    from {
      box-shadow: 0 0 0 rgb(10 10 11 / 0%);
      border-block-end-color: var(--c-rule);
    }

    to {
      box-shadow: var(--shadow-2);
      border-block-end-color: transparent;
    }
  }
</style>
