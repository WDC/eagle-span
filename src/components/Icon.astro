---
/*
 * The icon set: one file, one viewBox, one stroke weight.
 *
 * The mega menu lists fourteen offerings whose labels are all two words of
 * technical English — "Axle Repair", "Driveline Repair", "Suspension Repair" —
 * and a reader scanning a panel of them has nothing to aim at but the text.
 * The icons are the aiming point. They are drawn rather than decorative: an
 * axle is an axle, a brake disc is a brake disc, and wheel alignment gets the
 * alignment target, which is the one mark on this site that already means
 * "this is the one".
 *
 * Stroke, not fill, at 1.4 on a 24 unit box, in `currentColor`. That is the
 * same hairline the rules and the axes are drawn with, so an icon sits in the
 * drawing rather than on top of it — and it inverts inside `.t-deep` for free,
 * because it has no colour of its own.
 *
 * Keys are entry ids. An id with no drawing gets the generic wrench rather than
 * a hole, because a content editor adding a fifteenth repair should get a menu
 * that looks finished, not a menu with a gap in it where the icon goes.
 */
interface Props {
  name: string;
  class?: string | undefined;
}

const { name, class: className } = Astro.props;

/* Every path is stroked; none is filled. */
const PATHS: Record<string, string> = {
  /* ---- Services ------------------------------------------------------- */
  /* A clipboard with a check: the inspection that produces a sticker. */
  'dot-inspection': 'M9 4h6v3H9zM7 5.5H5.5v14h13v-14H17M9 13l2 2 4-4',
  /* A dial at three quarters and a tick: service before failure. */
  'preventative-maintenance': 'M12 4a8 8 0 1 1-5.66 2.34M12 7v5l3.5 2',
  /* A boom and a cab: the equipment, not the truck. */
  'heavy-equipment-repair': 'M4 19h16M6 19v-4h6v4M12 15l3-7 4 3M6 15l-1-3',
  /* Three trucks abreast: a fleet is a count. */
  'fleet-services': 'M3 8h7v6H3zM12 10h4l3 3v1h-7zM5.5 17.5h.01M17 17.5h.01M3 14v3.5M19 14v3.5',
  /* A cell with its terminals. */
  'battery-services': 'M4 8h13v8H4zM17 11h2v2h-2M7 10v4M7 12h3M13 12h-1.5',
  /* ---- Repairs -------------------------------------------------------- */
  /* Two wheels on one shaft. */
  'axle-repair': 'M7 12a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0M22 12a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0M7 12h10',
  /* A disc and a caliper over it. */
  'brake-repair': 'M12 4.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7M17.5 7l2-2',
  /* A trace with a fault in it. */
  diagnostics: 'M3 12h3l2-5 3 10 2.5-7 1.5 4 2-2h4',
  /* A shaft between two U-joints. */
  'driveline-repair': 'M5 9.5h2.5v5H5zM16.5 9.5H19v5h-2.5M7.5 12h9M9 10v4M15 10v4',
  /* A drop leaving the neck of a funnel. */
  'oil-fluid': 'M6 5h12l-5 6v7l-2 1v-8zM18.5 15.5c0 1-.7 1.7-1.5 1.7s-1.5-.7-1.5-1.7 1.5-3 1.5-3 1.5 2 1.5 3',
  /* A coil under load. */
  'suspension-repair': 'M6 4h12M6 20h12M8 6.5h8l-8 3h8l-8 3h8l-8 3h8',
  /* A tire and its tread. */
  'tire-repair': 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17M12 7.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9M12 3.5v4M12 16.5v4M3.5 12h4M16.5 12h4',
  /* Two gears meshed. */
  'transmission-clutch-repair': 'M9.5 6a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7M9.5 3.5v2.5M9.5 13v2.5M6 9.5H3.5M15.5 9.5H13M17 12.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6M17 11v1.5M17 18.5v1.5M13.5 15.5H12M22 15.5h-1.5',
  /* The alignment target, which is the site's own mark. */
  'wheel-alignment': 'M12 5.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M12 2v3M12 19v3M2 12h3M19 12h3',
  /* ---- Company and actions -------------------------------------------- */
  /* The building, with its bay doors. */
  about: 'M4 20V9l8-5 8 5v11M4 20h16M9 20v-5h6v5M8 11h2M14 11h2',
  /* Stacked sheets. */
  articles: 'M6 4h9l3 3v13H6zM15 4v3h3M9 11h6M9 14h6M9 17h4',
  /* A badge on a lanyard. */
  careers: 'M9 4h6v3H9zM5.5 7h13v13h-13zM12 11a2 2 0 1 0 0 4 2 2 0 0 0 0-4M8.5 18a3.5 3.5 0 0 1 7 0',
  /* A quotation mark set in a frame. */
  testimonials: 'M4 5h16v11H9l-5 4zM9 8.5c-1.4 0-2.5 1-2.5 2.3S7.6 13 9 13M15.5 8.5c-1.4 0-2.5 1-2.5 2.3S14.1 13 15.5 13',
  /* The pin. */
  contact: 'M12 3.5a6 6 0 0 0-6 6c0 4.2 6 10.9 6 10.9s6-6.7 6-10.9a6 6 0 0 0-6-6M12 7.2a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8',
  /* The handset, the same drawing as the masthead's. */
  phone: 'M7.8 3.8 9.9 8l-2 2a12.6 12.6 0 0 0 6.1 6.1l2-2 4.2 2.1v3.2c0 .9-.75 1.6-1.65 1.5A17.4 17.4 0 0 1 2.1 5.4c-.1-.9.6-1.6 1.5-1.6z',
  /* Fallback. */
  wrench: 'M15.5 3.5a5 5 0 0 0-4.2 7.7L4 18.5 5.5 20l7.3-7.3a5 5 0 0 0 6.7-6.2l-2.9 2.9-2.8-.7-.7-2.8z',
};

const d = PATHS[name] ?? PATHS.wrench;
---

<svg
  class={['c-icon', className].filter(Boolean).join(' ')}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <path
    d={d}
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>

<style>
  .c-icon {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    flex: none;
    /* Optical, not metric: a 24-unit drawing beside 14px text sits high. */
    vertical-align: -0.32em;
  }
</style>
