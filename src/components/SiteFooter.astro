---
import { NAV, PAGES, SECTIONS } from '~/lib/routes.ts';
import { getSingleton, listOfferings } from '~/lib/content.ts';
import { entryPath } from '~/lib/routes.ts';
import { site } from '~/site.config.ts';

/*
 * The footer, and the site's second link to every service and repair.
 *
 * The header links the two indexes; this links all fourteen children. Between
 * them every page is one hop from every other, which is the shape the crawl
 * found missing — and it is why the list here is built from the collections
 * rather than written out.
 *
 * It runs on the dark ground, which is the second and last inversion on the
 * site. That is deliberate: an inverted footer is the oldest way to say the
 * page has ended, and on a site whose sections are all white it is the thing
 * that stops the last band from reading as one more section.
 *
 * The hours link goes to `site.mapsUrl`. On the live homepage the same link
 * points at AES Truck Repair in Springfield, Missouri (Phase 0 defect 2). There
 * is exactly one Maps URL in this codebase and it is the shop's.
 */
const settings = await getSingleton('settings');
const { social, footerNote, cta } = settings.data;

const [services, repairs] = await Promise.all([listOfferings('services'), listOfferings('repairs')]);
const year = new Date().getFullYear();
---

<footer class="footer t-deep">
  <div class="l-page footer__inner">
    <div class="footer__nap">
      <p class="footer__brand">{site.name}</p>
      <address class="footer__address">
        {site.address.street}<br />
        {site.address.locality}, {site.address.region} <span class="u-tabular">{site.address.postalCode}</span>
      </address>

      <dl class="footer__facts">
        <div class="footer__fact">
          <dt class="u-label">Phone</dt>
          <dd><a class="footer__phone u-tabular u-nowrap" href={`tel:${site.phoneE164}`} data-conversion="call">{site.phoneDisplay}</a></dd>
        </div>
        <div class="footer__fact">
          <dt class="u-label">Hours</dt>
          <dd class="u-tabular">{site.hours.days}, {site.hours.opens}–{site.hours.closes}</dd>
        </div>
      </dl>

      <div class="footer__actions">
        <a class="c-btn c-btn--primary footer__cta" href={cta.href}>
          {cta.label}<span class="c-btn__mark" aria-hidden="true">→</span>
        </a>
        <a class="c-btn c-btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
          Directions<span class="u-visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </div>

    <nav class="footer__col" aria-label="Services">
      <p class="u-label"><a href={SECTIONS.services.index!}>{SECTIONS.services.label}</a></p>
      <ul>
        {services.map((entry) => <li><a href={entryPath('services', entry.id)}>{entry.data.navLabel}</a></li>)}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Repairs">
      <p class="u-label"><a href={SECTIONS.repairs.index!}>{SECTIONS.repairs.label}</a></p>
      <ul>
        {repairs.map((entry) => <li><a href={entryPath('repairs', entry.id)}>{entry.data.navLabel}</a></li>)}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Company">
      <p class="u-label">Company</p>
      <ul>
        {NAV.filter((item) => item.href !== SECTIONS.services.index && item.href !== SECTIONS.repairs.index).map(
          (item) => <li><a href={item.href}>{item.label}</a></li>,
        )}
        <li><a href={SECTIONS.articles.index!}>{SECTIONS.articles.label}</a></li>
        <li><a href={PAGES.careers}>Careers</a></li>
      </ul>
    </nav>
  </div>

  <div class="l-page footer__legal">
    {footerNote && <p class="footer__note">{footerNote}</p>}
    {
      social.length > 0 && (
        <ul class="footer__social">
          {social.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label}<span class="u-visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="footer__copy u-tabular">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--s-8);
    padding-block: var(--s-7) var(--s-5);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--s-6) var(--gutter);
  }

  /* The NAP column is the wide one: it carries the address and the actions. */
  @media (width >= 64rem) {
    .footer__inner { grid-template-columns: 1.4fr repeat(3, 1fr); }
  }

  .footer__brand {
    font-weight: 620;
    font-size: var(--t-h3);
    letter-spacing: var(--ls-heading);
  }

  .footer__address {
    font-style: normal;
    line-height: var(--lh-body);
    color: var(--c-ink-2);
    margin-block-start: var(--s-2);
  }

  .footer__facts { margin-block-start: var(--s-4); }

  .footer__fact {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--s-2);
    padding-block: var(--s-2);
    border-block-start: var(--hairline) solid var(--c-rule);
    font-size: var(--t-fine);
  }

  .footer__fact dt { padding-block-start: 0.2em; }
  .footer__fact dd { margin: 0; }

  .footer__phone {
    font-weight: 620;
    font-size: var(--t-body);
    text-decoration: none;
  }

  .footer__phone:hover { color: var(--c-target-ink); }

  .footer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block-start: var(--s-4);
  }

  /*
   * On the dark ground the solid button has to be the light one — see the same
   * inversion on the homepage closing band.
   */
  .footer__cta {
    background: var(--c-on-deep);
    border-color: var(--c-on-deep);
    color: var(--c-deep);
  }

  .footer__cta:hover {
    background: var(--c-on-deep-2);
    border-color: var(--c-on-deep-2);
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
    margin-block-start: var(--s-2);
    display: grid;
    gap: var(--s-1);
    font-size: var(--t-fine);
  }

  .footer__col a {
    text-decoration: none;
    color: var(--c-ink-2);
    transition: color var(--d-fast) var(--e-out);
  }

  .footer__col a:hover { color: var(--c-ink); text-decoration: underline; }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3) var(--s-5);
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-3);
    border-block-start: var(--hairline) solid var(--c-rule);
    font-size: var(--t-fine);
    color: var(--c-ink-3);
  }

  .footer__note { max-width: var(--measure-tight); }
  .footer__social { display: flex; gap: var(--s-3); list-style: none; padding: 0; }
  .footer__copy { margin-inline-start: auto; }
</style>
