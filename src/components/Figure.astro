---
import { getImage } from 'astro:assets';
/*
 * `ImageMetadata` is an Astro ambient global, and ESLint's `no-undef` has no
 * way to know that — a type it cannot see used in a type position reads as an
 * undefined identifier. Importing it from `astro` says the same thing to
 * TypeScript and stops the lint being a lie.
 */
import type { ImageMetadata } from 'astro';

import type { PlaceholderImage } from '~/lib/placeholders.ts';

/*
 * One image, framed.
 *
 * Every photograph on the site goes through here, which buys three things that
 * were being repeated by hand in five templates: an explicit intrinsic size so
 * the image cannot move the text under it while it loads, an aspect ratio the
 * layout owns rather than the file, and — while the shop photography is still
 * outstanding — a badge that says out loud that the picture is a stand-in.
 *
 * The badge is deliberately not subtle. A placeholder that looks like a design
 * decision is a placeholder that launches. It is `aria-hidden` because the alt
 * text of a placeholder already says so in words — see src/lib/placeholders.ts
 * — and repeating it would be the badge, not the picture, being announced.
 */
interface Props {
  image: PlaceholderImage | ImageMetadata | { src: string; width: number; height: number; isPlaceholder?: undefined };
  alt: string;
  /** CSS aspect ratio for the frame, e.g. "16 / 9". Defaults to 3 / 2. */
  ratio?: string | undefined;
  /** Above the fold, so it is not lazy and not decoded late. */
  eager?: boolean | undefined;
  /** Scales the image a little under the pointer. Cards and links only. */
  zoom?: boolean | undefined;
  caption?: string | undefined;
  class?: string | undefined;
  /**
   * The `sizes` attribute — how wide this figure actually renders. Without it a
   * browser assumes 100vw and downloads the 1600 for a card three to a row.
   */
  sizes?: string | undefined;
}

const {
  image,
  alt,
  ratio,
  eager = false,
  zoom = false,
  caption,
  class: className,
  sizes = '(width >= 64rem) 60vw, 100vw',
} = Astro.props;

const isPlaceholder = 'isPlaceholder' in image && image.isPlaceholder === true;

/*
 * Real photography goes through `astro:assets`; placeholders do not.
 *
 * The distinction is `format` — an `ImageMetadata` from `image()` in the
 * content schema carries one, and the two hand-built shapes (a placeholder
 * from the CDN, a plain src/width/height) do not. Only the first can be
 * resized at build time, so only the first gets a `srcset`.
 *
 * This matters more than it looks. The shop photographs are 2000px on the long
 * edge, and the pass that added them put one at the top of all thirty pages.
 * Served as-is that is a 400 KB download to fill a 700px column on a phone;
 * through here it is four widths and the browser picks one. The widths are
 * capped at the source width, because upscaling a photograph to fill a srcset
 * slot ships bytes that carry no detail.
 */
const isProcessable = typeof image === 'object' && 'format' in image;

const WIDTHS = [480, 800, 1200, 1600, 2000];

const processed = isProcessable
  ? await getImage({
      src: image as ImageMetadata,
      widths: WIDTHS.filter((width) => width <= (image as ImageMetadata).width),
      format: 'webp',
      quality: 78,
    })
  : null;

const classes = ['c-figure', zoom && 'c-figure--zoom', className].filter(Boolean).join(' ');
---

<figure class={classes} style={ratio ? `--ratio: ${ratio};` : undefined} data-placeholder={isPlaceholder ? '' : undefined}>
  <img
    src={processed?.src ?? image.src}
    srcset={processed?.srcSet.attribute || undefined}
    sizes={processed ? sizes : undefined}
    alt={alt}
    width={image.width}
    height={image.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
  />

  {
    isPlaceholder && (
      <p class="c-figure__badge u-label" aria-hidden="true">
        Placeholder
      </p>
    )
  }

  {caption && <figcaption class="c-figure__caption">{caption}</figcaption>}
</figure>

<style>
  /*
   * `aria-hidden` on the badge and no mention of it in the alt text: it is a
   * note to the people building the site, not information about the picture.
   * When the real photograph lands the badge goes with the placeholder, and
   * nothing in the accessible name has to change.
   */
  .c-figure__badge {
    position: absolute;
    inset-block-start: var(--s-2);
    inset-inline-start: var(--s-2);
    margin: 0;
    padding: 0.25rem 0.5rem;
    border-radius: var(--r-1);
    background: var(--c-deep);
    color: var(--c-on-deep-2);
    font-size: var(--t-micro);
  }

  .c-figure__caption { padding-inline: var(--s-1); }
</style>
