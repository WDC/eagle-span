---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { transitionName } from '~/lib/routes.ts';
import type { Crumb } from '~/lib/schema.ts';

/*
 * The top of every page that is not the homepage: the measurement rail, the
 * breadcrumb trail, the H1 and the lede.
 *
 * `mark` is the rail label — a section number or a short qualifier. It is
 * decoration in the sense that nothing depends on it, and structure in the
 * sense that the whole layout hangs off the rail it sits in.
 *
 * `path` is the far half of the title morph: given one, the H1 takes the same
 * `transition:name` as the `EntryList` row that links here, and the browser
 * carries the heading across the navigation. It is optional because most pages
 * have no row pointing at them — nothing lists /contact — and a name with no
 * partner is a name for the sake of it.
 */
interface Props {
  mark?: string | undefined;
  title: string;
  lede?: string | undefined;
  crumbs?: readonly Crumb[] | undefined;
  /** This page's own path, when an index links to it. Names the title morph. */
  path?: string | undefined;
}

const { mark, title, lede, crumbs = [], path } = Astro.props;
---

<header class="l-page l-section pagehead">
  <div class="l-rail">
    <p class="l-rail__mark u-label u-tabular">{mark}</p>
    <div class="l-rail__body l-stack">
      <Breadcrumbs {crumbs} />
      {/*
        Two branches rather than one `transition:name={path ? … : undefined}`,
        and rather than spreading the attribute in. `transition:name` is a
        compiler directive, not an attribute: written literally it becomes a
        scope class and a `view-transition-name` rule, and passed through a
        spread it is emitted verbatim into the HTML as `transition:name="…"`,
        which no browser has ever read. The page looks right and the morph
        silently does not happen — `verify:motion` checks the built output for
        that exact string, because it is invisible everywhere else.
      */}
      {path ? <h1 transition:name={transitionName(path)}>{title}</h1> : <h1>{title}</h1>}
      {lede && <p class="pagehead__lede">{lede}</p>}
      <slot />
    </div>
  </div>
</header>

<style>
  .pagehead { padding-block-end: var(--s-5); }

  .pagehead__lede {
    font-size: var(--t-lead);
    color: var(--c-ink-2);
    max-width: var(--measure);
  }
</style>
