---
import Figure from '~/components/Figure.astro';
import { site, staticMap } from '~/site.config.ts';

import shopFront from '~/assets/photos/shop-bays.webp';

/*
 * Where the shop is, as data.
 *
 * There is no Google Maps iframe here and there never will be — see
 * `staticMap` in src/site.config.ts. The block is the NAP and a link to the
 * listing, which is what a reader actually needs; the picture is an
 * improvement on that, not a prerequisite for it.
 *
 * Until the static map exists the slot holds a photograph of the shop rather
 * than a placeholder. That was the right call while nothing real existed —
 * a picture that says “Placeholder” reads as a picture that has not arrived —
 * and it is the wrong one now that the photography is in: a broken CDN frame
 * with a badge on it sits directly beside the address on /contact, which is
 * the page a reader opens when they are trying to reach the place.
 *
 * The link is still the map. What is under it is the building the link leads
 * to, which is a better answer to “is this the right place” than a grey square.
 *
 * Every string below renders from site.config, so this is one more place the
 * phone number cannot pick up a sixth format.
 */
const mapAlt = 'The Eagle Span shop floor in Charlotte, on Beasley Lane';
---

<div class="location c-panel">
  <a class="location__map" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
    {
      staticMap ? (
        <Figure
          image={{ src: staticMap.src, width: staticMap.width, height: staticMap.height }}
          alt={staticMap.alt}
          ratio="3 / 2"
          zoom
        />
      ) : (
        <Figure image={shopFront} alt={mapAlt} ratio="3 / 2" sizes="(width >= 52rem) 22rem, 92vw" zoom />
      )
    }
    <span class="u-visually-hidden">Open the shop location in Google Maps (opens in a new tab)</span>
  </a>

  <dl class="location__spec">
    <div class="location__row">
      <dt class="u-label">Address</dt>
      <dd>
        <address>
          {site.address.street}<br />
          {site.address.locality}, {site.address.region} <span class="u-tabular">{site.address.postalCode}</span>
        </address>
      </dd>
    </div>
    <div class="location__row">
      <dt class="u-label">Phone</dt>
      <dd><a class="u-tabular u-nowrap" href={`tel:${site.phoneE164}`} data-conversion="call">{site.phoneDisplay}</a></dd>
    </div>
    <div class="location__row">
      <dt class="u-label">Hours</dt>
      <dd class="u-tabular">{site.hours.days}, {site.hours.opens}–{site.hours.closes}</dd>
    </div>
    <div class="location__row">
      <dt class="u-label">Area served</dt>
      <dd>{site.areaServed}</dd>
    </div>
  </dl>

  <a class="c-btn c-btn--ghost c-btn--block location__cta" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
    Open in Google Maps<span class="c-btn__mark" aria-hidden="true">→</span>
    <span class="u-visually-hidden"> (opens in a new tab)</span>
  </a>
</div>

<style>
  .location {
    max-width: 26rem;
    display: grid;
    gap: var(--s-3);
    padding: var(--s-3);
  }

  .location__map { display: block; text-decoration: none; }

  .location__row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--s-3);
    padding-block: var(--s-2);
    border-block-start: var(--hairline) solid var(--c-rule);
    font-size: var(--t-fine);
  }

  .location__row dt { padding-block-start: 0.2em; }
  .location__row dd { margin: 0; }
  .location__row address { font-style: normal; line-height: var(--lh-body); }

  .location__cta { margin-block-start: var(--s-1); }

  @media (width < 32rem) {
    .location__row { grid-template-columns: minmax(0, 1fr); gap: var(--s-0); }
  }
</style>
