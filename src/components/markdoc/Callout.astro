---
/*
 * `{% callout %}`. A note, a caution or a safety warning.
 *
 * Phase 2 drew this as a hairline axis and a label, on the rule that nothing on
 * the site sits in a tinted box. In prose that turned out to be too quiet to do
 * its job: a safety warning that looks exactly like a block quote is a safety
 * warning the reader scrolls past, and on a page about air brakes that is the
 * one paragraph that must not be missed.
 *
 * So it is a panel now, and the tone is carried three ways over: the label, the
 * weight and colour of the axis, and the wash. Three, because each one fails
 * somewhere — the wash is gone in print and in forced-colours mode, the colour
 * is gone for a reader who cannot distinguish it, and the label is the only one
 * that survives everything. The colour is never the sole carrier of the tone,
 * which is the WCAG rule and also just how a shop marks a hazard.
 */
interface Props {
  tone?: 'note' | 'caution' | 'safety' | undefined;
  title?: string | undefined;
}

const { tone = 'note', title } = Astro.props;

/*
 * The label is the accessible name of the region, so a screen reader announces
 * "Safety" before the text rather than an unlabelled aside.
 */
const TONE_LABEL = { note: 'Note', caution: 'Caution', safety: 'Safety' } as const;
const label = TONE_LABEL[tone];
---

<aside class="callout" data-tone={tone} aria-label={title ?? label}>
  <p class="callout__label u-label">{label}</p>
  <div class="callout__body l-stack">
    {title && <p class="callout__title">{title}</p>}
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin-block: var(--s-5);
    padding: var(--s-3) var(--pad-panel);
    border-inline-start: 3px solid var(--c-rule-strong);
    border-radius: 0 var(--r-2) var(--r-2) 0;
    background: var(--c-ground-2);
    max-width: var(--measure);
  }

  .callout[data-tone='note'] {
    border-inline-start-color: var(--c-blue);
    background: var(--c-wash-blue);
  }

  .callout[data-tone='caution'] {
    border-inline-start-color: var(--c-amber);
    background: var(--c-wash-amber);
  }

  .callout[data-tone='safety'] {
    border-inline-start-color: var(--c-red);
    background: var(--c-wash-red);
  }

  .callout__label {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    margin-block-end: var(--s-1);
  }

  .callout[data-tone='note'] .callout__label { color: var(--c-blue-deep); }
  .callout[data-tone='caution'] .callout__label { color: var(--c-amber-ink); }
  .callout[data-tone='safety'] .callout__label { color: var(--c-red); }

  .callout__title { font-weight: 620; }

  /* Inside a callout the measure is the panel, not the page. */
  .callout :global(p) { max-width: none; }
</style>
