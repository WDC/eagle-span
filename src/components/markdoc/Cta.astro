---
/*
 * `{% cta %}`. One action, on its own rule.
 *
 * The destination is validated in markdoc.config.mjs: a path on this site, a
 * tel:, a mailto: or a fragment, and nothing else. Body copy is not where an
 * off-site call to action belongs, and an unvalidated href in a content repo is
 * how `javascript:` eventually gets in.
 */
interface Props {
  label: string;
  href: string;
}

const { label, href } = Astro.props;
---

<p class="cta">
  <a class="c-btn c-btn--primary" href={href}>
    {label}<span class="c-btn__mark" aria-hidden="true">→</span>
  </a>
</p>

<style>
  /*
   * One action, on its own rule, and it is a button now rather than a bolded
   * link: inside a thousand words of prose the difference between “this is a
   * link” and “this is the thing to do next” has to be visible at a glance,
   * and weight alone was not doing it.
   */
  .cta {
    margin-block: var(--s-5);
    padding-block-start: var(--s-4);
    border-block-start: var(--hairline) solid var(--c-rule);
    max-width: var(--measure);
  }
</style>
