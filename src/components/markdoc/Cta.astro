---
/*
 * `{% cta %}`. One action, on its own rule.
 *
 * The destination is validated in markdoc.config.mjs: a path on this site, a
 * tel:, a mailto: or a fragment, and nothing else. Body copy is not where an
 * off-site call to action belongs, and an unvalidated href in a content repo is
 * how `javascript:` eventually gets in.
 */
interface Props {
  label: string;
  href: string;
}

const { label, href } = Astro.props;
---

<p class="cta">
  <a class="cta__link" href={href}>{label}<span class="cta__mark" aria-hidden="true">→</span></a>
</p>

<style>
  .cta {
    margin-block: var(--s-5);
    padding-block-start: var(--s-3);
    border-block-start: var(--hairline) solid var(--c-rule);
    max-width: var(--measure);
  }

  .cta__link {
    font-weight: 620;
    text-decoration: none;
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-1);
  }

  .cta__link:hover { text-decoration: underline; }

  .cta__mark {
    color: var(--c-target-ink);
    transition: transform var(--d-fast) var(--e-out);
  }

  .cta__link:hover .cta__mark { transform: translateX(0.15em); }
</style>
