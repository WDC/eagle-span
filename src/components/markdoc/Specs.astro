---
import type { SpecRow } from '~/lib/markdoc-tags.ts';

/*
 * `{% specs %}`. A measured column: hairline rules, lining tabular figures, in
 * a panel — see the note in the stylesheet for why the rail version had to go.
 *
 * The rows are validated in markdoc.config.mjs (a non-empty label and value,
 * an optional note, nothing else), so this renders without guarding shapes.
 */
interface Props {
  label?: string;
  rows: readonly SpecRow[];
}

const { label, rows } = Astro.props;
---

<div class="specs c-panel">
  {
    label && (
      <p class="c-kicker">
        <span class="c-tick" aria-hidden="true" />
        <span class="u-label">{label}</span>
      </p>
    )
  }

  <dl class="specs__list">
    {
      rows.map((row) => (
        <div class="specs__row">
          <dt class="u-label">{row.label}</dt>
          <dd class="u-tabular">
            {row.value}
            {row.note && <span class="specs__note"> {row.note}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  /*
   * A measured column: hairline rules, lining tabular figures, and now a panel
   * around them. The rail version put the label in the page's own rail, which
   * meant a spec block inside a two-column page had its title in a different
   * column from its rows — the one place the rail was actively wrong.
   *
   * This is the numeric split from Phase 2 made available to content: prose
   * keeps old-style proportional figures, and anything that has to align down a
   * column opts into `.u-tabular` here.
   */
  .specs {
    margin-block: var(--s-5);
    max-width: var(--measure);
    padding: var(--s-3) var(--pad-panel);
    background: var(--c-ground-2);
  }

  .specs__row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--s-3);
    padding-block: var(--s-2);
    border-block-start: var(--hairline) solid var(--c-rule);
  }

  .specs__row:first-child { border-block-start: 0; }
  .specs__row dt { padding-block-start: 0.2em; }
  .specs__row dd { margin: 0; }

  /* A qualifier is not a reading: it stays in prose figures and steps back. */
  .specs__note {
    color: var(--c-ink-3);
    font-size: var(--t-fine);
    font-variant-numeric: oldstyle-nums proportional-nums;
  }

  @media (width < 32rem) {
    .specs__row { grid-template-columns: minmax(0, 1fr); gap: var(--s-0); }
  }
</style>
